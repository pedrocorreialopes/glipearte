<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" aria-label="Imagem de festa">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f0d890"/>
      <stop offset="100%" style="stop-color:#d8d8d8"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <circle cx="200" cy="120" r="50" fill="#ffffff" opacity="0.4"/>
  <rect x="150" y="170" width="100" height="60" rx="8" fill="#ffffff" opacity="0.5"/>
  <text x="50%" y="85%" text-anchor="middle" font-family="Inter, sans-serif" font-size="16" fill="#1a1a1a" font-weight="600">Glipearte</text>
  <text x="50%" y="92%" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#333">Imagem ilustrativa</text>
</svg>
